{
  "name": "wobnimo",
  "version": "0.2.0",
  "description": "Twenty living 3D mascots on one featherweight web animation engine, plus a skill and CLI that let your agent design your own from one sentence. Zero dependencies, ~25 KB.",
  "keywords": [
    "mascot",
    "animation",
    "avatar",
    "character",
    "webgl",
    "agent",
    "ai",
    "chatbot",
    "assistant",
    "web-component",
    "react",
    "skill",
    "claude-code",
    "mascot-generator"
  ],
  "homepage": "https://pouryaak.github.io/wobnimo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pouryaak/wobnimo.git",
    "directory": "packages/wobnimo"
  },
  "license": "MIT",
  "author": "Pourya Akhbari",
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./dist/cdn.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./characters": {
      "types": "./dist/characters/index.d.ts",
      "import": "./dist/characters/index.js"
    },
    "./characters/*": {
      "types": "./dist/characters/*.d.ts",
      "import": "./dist/characters/*.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wobnimo": "./dist/cli.js"
  },
  "unpkg": "./dist/wobnimo.js",
  "jsdelivr": "./dist/wobnimo.js",
  "files": [
    "dist",
    "skill",
    "AGENTS.md",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node ../../scripts/skill.mjs --copy skill",
    "prepack": "cp ../../README.md README.md"
  },
  "bugs": {
    "url": "https://github.com/Pouryaak/wobnimo/issues"
  },
  "typesVersions": {
    "*": {
      "characters": [
        "./dist/characters/index.d.ts"
      ],
      "characters/*": [
        "./dist/characters/*.d.ts"
      ],
      "element": [
        "./dist/element.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  }
}
